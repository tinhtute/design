{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**", "public/r/**"]
    },
    "app#build": {
      "dependsOn": ["@therealtinhtute/registry#build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "public/r/**"]
    },

    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
